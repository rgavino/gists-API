        </mxCell>
        <mxCell id="o-e11" value="JSON response (send_json)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="o-r200h" target="o-client">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="885" y="50" />
              <mxPoint x="80" y="50" />
