<mxfile host="drawio" version="24.7.17">
  <diagram id="overview" name="1. Solution overview">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="o-title" value="&lt;b&gt;Gists API — request flow (app.py)&lt;/b&gt;" style="text;html=1;fontSize=18;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="600" height="30" as="geometry" />
        </mxCell>

        <mxCell id="o-docker" value="&lt;b&gt;Docker container&lt;/b&gt; (python:3.12-slim, port 8080) — app.py, stdlib only" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="200" y="60" width="840" height="580" as="geometry" />
        </mxCell>

        <mxCell id="o-client" value="&lt;b&gt;Client&lt;/b&gt;&lt;br&gt;curl /octocat" style="shape=actor;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="60" y="100" width="40" height="70" as="geometry" />
        </mxCell>

        <mxCell id="o-server" value="&lt;b&gt;ThreadingHTTPServer&lt;/b&gt;&lt;br&gt;0.0.0.0:PORT&lt;br&gt;one thread per request" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="230" y="100" width="220" height="70" as="geometry" />
        </mxCell>

        <mxCell id="o-life" value="&lt;b&gt;Lifecycle &amp;amp; config&lt;/b&gt;&lt;br&gt;• SIGTERM (docker stop) → KeyboardInterrupt → server_close() waits for in-flight requests&lt;br&gt;• Env: PORT, GITHUB_API, GITHUB_TOKEN (optional, raises rate limit)&lt;br&gt;• Logs go to logger &quot;gists&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="230" y="220" width="220" height="160" as="geometry" />
        </mxCell>

        <mxCell id="o-d1" value="path == healthz?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="520" y="95" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="o-d2" value="matches&lt;br&gt;USERNAME_RE?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="520" y="205" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="o-d3" value="page / per_page&lt;br&gt;valid?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="520" y="315" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="o-fetch" value="&lt;b&gt;fetch_gists(user, page, per_page)&lt;/b&gt;&lt;br&gt;urlopen(GITHUB_API/users/&amp;lt;user&amp;gt;/gists)&lt;br&gt;timeout 10s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="500" y="440" width="200" height="80" as="geometry" />
        </mxCell>

        <mxCell id="o-r200h" value="200 {&quot;status&quot;: &quot;ok&quot;}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="760" y="110" width="250" height="50" as="geometry" />
        </mxCell>
        <mxCell id="o-r404" value="404 not found&lt;br&gt;&lt;i&gt;GitHub is never called&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="760" y="220" width="250" height="50" as="geometry" />
        </mxCell>
        <mxCell id="o-r400" value="400 invalid page / per_page&lt;br&gt;&lt;i&gt;(per_page silently capped at 100)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="760" y="330" width="250" height="50" as="geometry" />
        </mxCell>
        <mxCell id="o-map" value="&lt;b&gt;Response mapping&lt;/b&gt;&lt;br&gt;GitHub 200 → &lt;b&gt;200&lt;/b&gt; summarised list&lt;br&gt;&amp;nbsp;&amp;nbsp;(id, description, url, files, created_at, updated_at)&lt;br&gt;GitHub 404 → &lt;b&gt;404&lt;/b&gt; user not found&lt;br&gt;GitHub 403 / 429 → &lt;b&gt;503&lt;/b&gt; rate limited + WARNING log&lt;br&gt;&amp;nbsp;&amp;nbsp;(includes x-ratelimit-remaining / reset)&lt;br&gt;Other GitHub error → &lt;b&gt;502&lt;/b&gt; + WARNING log&lt;br&gt;URLError / timeout → &lt;b&gt;502&lt;/b&gt; + ERROR log" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="760" y="420" width="260" height="190" as="geometry" />
        </mxCell>

        <mxCell id="o-github" value="&lt;b&gt;GitHub REST API&lt;/b&gt;&lt;br&gt;api.github.com&lt;br&gt;GET /users/{user}/gists" style="shape=cloud;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="1080" y="230" width="190" height="120" as="geometry" />
        </mxCell>

        <mxCell id="o-e1" value="GET /&amp;lt;user&amp;gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="o-client" target="o-server">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="o-e2" value="Handler.do_GET" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="o-server" target="o-d1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="o-e3" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="o-d1" target="o-r200h">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="o-e4" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="o-d1" target="o-d2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="o-e5" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="o-d2" target="o-r404">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="o-e6" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="o-d2" target="o-d3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="o-e7" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="o-d3" target="o-r400">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="o-e8" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="o-d3" target="o-fetch">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="o-e9" value="HTTPS (+ Bearer token if set)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="o-fetch" target="o-github">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="600" y="670" />
              <mxPoint x="1175" y="670" />
