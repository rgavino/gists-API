          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="tests" name="2. How the unit tests work">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1450" pageHeight="1150" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="t-title" value="&lt;b&gt;test_app.py — real server, fake GitHub&lt;/b&gt;&amp;nbsp;&amp;nbsp;(python -m unittest -v)" style="text;html=1;fontSize=18;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="800" height="30" as="geometry" />
        </mxCell>

        <mxCell id="t-proc" value="&lt;b&gt;One Python test process&lt;/b&gt; (no network needed for TestWithMockedGitHub)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="20" y="50" width="1120" height="710" as="geometry" />
        </mxCell>

        <mxCell id="t-lane-test" value="&lt;b&gt;Test thread&lt;/b&gt; (unittest)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="320" height="650" as="geometry" />
        </mxCell>
        <mxCell id="t-lane-srv" value="&lt;b&gt;Server thread&lt;/b&gt; (daemon) — real app.Handler, unmodified" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="760" y="90" width="360" height="400" as="geometry" />
        </mxCell>

        <mxCell id="t-setupclass" value="&lt;b&gt;setUpClass&lt;/b&gt; (once per test class)&lt;br&gt;ThreadingHTTPServer(&quot;127.0.0.1&quot;, &lt;b&gt;0&lt;/b&gt;) → OS picks a free port → base_url&lt;br&gt;serve_forever() on a daemon thread" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="60" y="130" width="280" height="80" as="geometry" />
        </mxCell>
        <mxCell id="t-setup" value="&lt;b&gt;setUp&lt;/b&gt; (before each test)&lt;br&gt;• mock.patch(&quot;urllib.request.urlopen&quot;, side_effect=&lt;b&gt;router&lt;/b&gt;)&lt;br&gt;• self.calls = []&lt;br&gt;• self.github = fake returning [OCTOCAT_GIST]&lt;br&gt;• addCleanup(patcher.stop)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="60" y="230" width="280" height="100" as="geometry" />
        </mxCell>
        <mxCell id="t-arrange" value="&lt;b&gt;Arrange&lt;/b&gt; (optional, per test)&lt;br&gt;github_error(404 / 403 / 500, headers)&lt;br&gt;or self.github = unreachable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="60" y="350" width="280" height="70" as="geometry" />
        </mxCell>
        <mxCell id="t-act" value="&lt;b&gt;Act&lt;/b&gt;: self.get(&quot;/octocat&quot;)&lt;br&gt;→ urllib.request.urlopen(base_url + path)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="60" y="440" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="t-assert" value="&lt;b&gt;Assert&lt;/b&gt;&lt;br&gt;• HTTP status + JSON body&lt;br&gt;• self.calls → URL sent to GitHub (page / per_page),&lt;br&gt;&amp;nbsp;&amp;nbsp;or [] = GitHub was never called&lt;br&gt;• assertLogs(&quot;gists&quot;, WARNING / ERROR)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="60" y="610" width="280" height="110" as="geometry" />
        </mxCell>

        <mxCell id="t-router" value="&lt;b&gt;Patched urllib.request.urlopen&lt;/b&gt;&lt;br&gt;→ router(request)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="430" y="250" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="t-decide" value="URL starts with&lt;br&gt;base_url?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="470" y="350" width="160" height="90" as="geometry" />
        </mxCell>
        <mxCell id="t-fake" value="&lt;b&gt;Fake GitHub&lt;/b&gt; = self.github(request)&lt;br&gt;• default: BytesIO(json [OCTOCAT_GIST])&lt;br&gt;• github_error(status): raise HTTPError&lt;br&gt;• unreachable: raise URLError" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="410" y="560" width="280" height="90" as="geometry" />
        </mxCell>

        <mxCell id="t-handler" value="&lt;b&gt;app.Handler.do_GET&lt;/b&gt;&lt;br&gt;healthz / username regex / page validation&lt;br&gt;&lt;i&gt;can answer 200 / 404 / 400 without calling GitHub&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="780" y="130" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="t-fetch" value="&lt;b&gt;app.fetch_gists&lt;/b&gt;&lt;br&gt;urllib.request.urlopen(api.github.com/users/…/gists)&lt;br&gt;maps errors → 404 / 503 / 502, logs to &quot;gists&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="780" y="300" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="t-resp" value="&lt;b&gt;send_json&lt;/b&gt;(status, body)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="780" y="420" width="320" height="50" as="geometry" />
        </mxCell>

        <mxCell id="t-why" value="&lt;b&gt;Why a router, not a plain mock?&lt;/b&gt;&lt;br&gt;The test client and the app both call urllib.request.urlopen. Patching it outright would also intercept the test's own request to the server.&lt;br&gt;&lt;br&gt;router() checks the URL: loopback calls to base_url go to the &lt;b&gt;real&lt;/b&gt; urlopen; everything else is recorded in self.calls and answered by the fake." style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="1170" y="90" width="250" height="230" as="geometry" />
        </mxCell>

        <mxCell id="t-real" value="&lt;b&gt;Real api.github.com&lt;/b&gt;&lt;br&gt;Only TestAgainstRealGitHub (no patch).&lt;br&gt;Skipped when SKIP_INTEGRATION=1" style="shape=cloud;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1170" y="370" width="250" height="140" as="geometry" />
        </mxCell>

        <mxCell id="t-e0a" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="t-setupclass" target="t-setup">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t-e0b" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="t-setup" target="t-arrange">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t-e0c" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="t-arrange" target="t-act">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t-e0d" value="patches" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="t-setup" target="t-router">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="t-e1" value="&lt;b&gt;1&lt;/b&gt;. test request" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#6c8ebf;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.25;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="t-act" target="t-router">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="390" y="470" />
              <mxPoint x="390" y="330" />
              <mxPoint x="490" y="330" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="t-e1b" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="t-router" target="t-decide">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t-e2" value="&lt;b&gt;2&lt;/b&gt;. yes → real urlopen&lt;br&gt;(real HTTP over loopback)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#6c8ebf;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="t-router" target="t-handler">
          <mxGeometry x="0.2" relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="550" y="170" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="t-e2b" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="t-handler" target="t-fetch">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t-e3" value="&lt;b&gt;3&lt;/b&gt;. app calls GitHub&lt;br&gt;via the &lt;i&gt;same&lt;/i&gt; patched urlopen" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#82b366;exitX=0;exitY=0.25;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="t-fetch" target="t-router">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t-e4" value="&lt;b&gt;4&lt;/b&gt;. no → self.calls.append(url)&lt;br&gt;then self.github(request)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#9673a6;" edge="1" parent="1" source="t-decide" target="t-fake">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t-e5" value="&lt;b&gt;5&lt;/b&gt;. JSON bytes / HTTPError / URLError" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#9673a6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.25;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="t-fake" target="t-fetch">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="720" y="605" />
              <mxPoint x="720" y="400" />
              <mxPoint x="860" y="400" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="t-e5b" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="t-fetch" target="t-resp">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t-e6" value="&lt;b&gt;6&lt;/b&gt;. HTTP response (status, JSON)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#82b366;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="t-resp" target="t-assert">
          <mxGeometry x="0.3" relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="940" y="700" />
              <mxPoint x="400" y="700" />
              <mxPoint x="400" y="665" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="t-e7" value="integration test only" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;strokeColor=#666666;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="t-fetch" target="t-real">
